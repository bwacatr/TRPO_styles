<Page x:Class="TRPO_styles.GradePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_styles"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GradePage">

    <Grid>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource TitlePanel}">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Title}" >Изменение темы</TextBlock>
                <Button x:Name="BackBtn" HorizontalAlignment="Right"  Content="Назад" DockPanel.Dock="Right" Click="BackBtn_Click" />
                <Button x:Name="ChangeThemeBtn" HorizontalAlignment="Right"  Content="Сменить тему" DockPanel.Dock="Right" Click="ChangeThemeBtn_Click" />

            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Text="Название темы"/>
                <TextBox Text="4" Grid.Row="1" />

                <StackPanel Grid.Row="3" VerticalAlignment ="Bottom" Orientation="Horizontal" >
                    <Button Style="{StaticResource DangerButton}" x:Name="ContinueBtn" Content="Продолжить" HorizontalAlignment="Left" Click="ContinueBtn_Click"/>
                </StackPanel>




                <TextBox Style="{StaticResource Large}" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Column="1" Text="Пояснение к оценке" />

            </Grid>
        </DockPanel>
    </Grid>
</Page>
