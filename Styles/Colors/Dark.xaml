<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Background" Color="#1E1E1E"/>

    <SolidColorBrush x:Key="TextBlockBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TextBlockForeground" Color="#F1F1F1"/>

    <SolidColorBrush x:Key="ButtonBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#3E3E42"/>
