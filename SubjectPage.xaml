<Page x:Class="TRPO_styles.SubjectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_styles"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SubjectPage">

    <Grid>
        <DockPanel LastChildFill="True">
            <DockPanel Style="{StaticResource TitlePanel}" DockPanel.Dock="Top" Background="LightBlue">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Title}" >Предмет</TextBlock>
                <Button x:Name="BackBtn" HorizontalAlignment="Right"  Content="Назад" DockPanel.Dock="Right"/>
                <Button x:Name="ChangeThemeBtn" HorizontalAlignment="Right"  Content="Сменить тему" DockPanel.Dock="Right"/>
                
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    
                    
                </Grid.RowDefinitions>

                <RadioButton Content="Режим просмотра" Grid.Row="0"/>
                <RadioButton Content="Режим редактирования" Grid.Row="1"/>
                
                <StackPanel Grid.Row="3" VerticalAlignment ="Bottom">
                    <Button Style="{StaticResource MainButton}" x:Name="AddBtn" Content="Добавить" />
                    <StackPanel  Orientation="Horizontal">
                        <Button Style="{StaticResource DangerButton}" x:Name="DeleteBtn"  Content="Удалить"  />
                        <Button  x:Name="SaveBtn" Content="Сохранить"   />
                    </StackPanel>
                </StackPanel>




                <ProgressBar Grid.Row="0" Grid.Column="1" Value="70" />
                <ListView MouseDoubleClick="ThemeListView_MouseDoubleClick" ItemContainerStyle="{StaticResource Themes}" Grid.Column="1"  x:Name="ThemeListView" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Grid.RowSpan="4" Grid.Row="1" >
                    
                </ListView>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
